{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "spaces"
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 240
      },
      "min": 44,
      "max": 480,
      "hidden": true,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "bar",
          "type": "block",
          "content": {
            "mod": "kanban",
            "props": {
              "part": "bar"
            }
          },
          "size": {
            "px": 44
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "view",
              "type": "stack",
              "children": [
                {
                  "id": "board-view",
                  "type": "row",
                  "children": [
                    {
                      "id": "board",
                      "type": "block",
                      "content": {
                        "mod": "kanban",
                        "props": {
                          "part": "board"
                        }
                      },
                      "min": 160
                    },
                    {
                      "id": "detail",
                      "type": "block",
                      "content": {
                        "agent": "focused"
                      },
                      "size": {
                        "px": 460
                      },
                      "min": 200,
                      "max": 4000,
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "radius": 14,
                      "shadow": "md"
                    }
                  ],
                  "gap": 12
                },
                {
                  "id": "tabs-view",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                }
              ],
              "active": "board-view"
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-head",
                  "type": "block",
                  "content": {
                    "mod": "kanban",
                    "props": {
                      "part": "panel-head"
                    }
                  },
                  "size": {
                    "px": 28
                  }
                },
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "stack",
                      "children": [
                        {
                          "id": "git-changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          },
                          "title": "Repository"
                        }
                      ],
                      "active": "git-changes",
                      "header": {
                        "content": "tabs",
                        "height": 32
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 240,
              "max": 1200,
              "hidden": true,
              "resizable": false
            }
          ],
          "padding": 12,
          "gap": 12
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/kanban.svg"
}
